/* Personal Agent · layout. Accent colours per tab live in theme.py. */

Screen { background: #262624; color: #ece9e4; }

#body { height: 1fr; }

/* sidebar */
#side { width: 26; background: #1f1e1d; }
#brand { height: 3; padding: 1 2 0 2; }
#sidebar { height: 1fr; background: #1f1e1d; background-tint: #000000 0%; padding: 0 1; }
#sidebar > ListItem { height: 3; padding: 1 1 0 1; background: #1f1e1d; }
#sidebar > ListItem.-highlight,
#sidebar:focus > ListItem.-highlight { color: #1a1918; }
#conn { height: 2; padding: 0 2; }

/* main */
#main { width: 1fr; padding: 1 3 0 3; }
#title { height: 2; margin-bottom: 1; }
#switcher, .panel { height: 1fr; background: #262624; }

/* rounded cards, title in the border */
.card {
    height: auto;
    padding: 1 2;
    margin: 0 1 1 0;
    background: #262624;
    border-title-align: left;
}

/* lists inside panels */
.pick {
    width: 42;
    height: 1fr;
    background: #262624;
    background-tint: #000000 0%;
    padding: 0;
}
.pick > ListItem {
    background: #262624;
    padding: 1 2;
    height: auto;
    border-left: thick #262624;
}
.pick > ListItem.-highlight { background: #30302e; border-left: thick #6d6963; }
#review-list:focus > ListItem.-highlight { border-left: thick #e5b85c; }
#area-list:focus > ListItem.-highlight   { border-left: thick #5ec4b6; }
#habit-list:focus > ListItem.-highlight  { border-left: thick #8fcf7f; }

.detail {
    width: 1fr;
    height: auto;
    max-height: 100%;
    margin: 0 0 0 2;
    padding: 1 3;
}

/* home */
#hello { height: 1; }
#date { height: 2; }
#tiles { height: auto; }
.tile { width: 1fr; padding: 0 2; }
#home-cols { height: auto; }
#home-cols > .card { width: 1fr; }

/* hobbies */
#hobby-grid { grid-size: 2; grid-rows: 6; grid-gutter: 1 1; height: auto; }
.hobby { height: 100%; margin: 0; }

/* people */
#people-table { height: auto; max-height: 100%; background: #262624; background-tint: #000000 0%; }
#people-table > .datatable--header { background: #262624; color: #a9a49c; text-style: bold; }
#people-table > .datatable--cursor { background: #30302e; }
#people-table:focus > .datatable--cursor { background: #f0a37a; color: #1a1918; text-style: bold; }
#people-table > .datatable--hover { background: #30302e; }

/* habits */
#habits-head { height: 2; }
#habit-list { width: 1fr; }

/* chat */
#chat { height: 1fr; }
.row { height: auto; width: 1fr; margin-bottom: 1; }
.row-me { align-horizontal: right; }
.msg { width: auto; max-width: 70%; height: auto; padding: 1 2; }
.msg-agent { background: #30302e; }
.msg-me { background: #d97757; color: #1a1918; text-style: bold; }
#chat-input { background: #262624; border: round #3e3d3a; padding: 0 1; margin-bottom: 1; }
#chat-input:focus { border: round #d97757; }

/* bottom bar */
#hints { height: 3; padding: 1 0 0 0; background: #1f1e1d; }

Toast { background: #30302e; }

/* quiet scrollbars */
* {
    scrollbar-size-vertical: 1;
    scrollbar-color: #3e3d3a;
    scrollbar-color-hover: #6d6963;
    scrollbar-color-active: #a9a49c;
    scrollbar-background: #262624;
    scrollbar-background-hover: #262624;
    scrollbar-background-active: #262624;
}
