# Personal Agent settings. Create your own with `python3 setup.py`.
# Never commit .env.
USER_NAME=
# Link or 32-character ID of your Notion root page.
NOTION_ROOT_PAGE_ID=
USER_LANGUAGE=English
USER_TIMEZONE=UTC
# Notion integration token (only for scripts / the MCP server, not for Cowork).
NOTION_TOKEN=

# Only for `agent-mcp --transport http` (see README "Running it over HTTP").
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PERSONAL_AGENT_TOKEN=
# Extra Host names the HTTP server accepts besides localhost (comma-separated), e.g. a Tailscale name.
PERSONAL_AGENT_ALLOWED_HOSTS=

# Remote access for hosted assistants (Claude app, ChatGPT, ...). Leave both empty to keep OAuth off.
# Public HTTPS address of this server (Tailscale Funnel or a Cloudflare Tunnel hostname).
PERSONAL_AGENT_PUBLIC_URL=
# Password you type on the login page when an assistant connects (min. 12 characters, use a long random one).
PERSONAL_AGENT_OWNER_PASSWORD=
